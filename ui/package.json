		"@types/node": "^22.20.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0"
	},
	"dependencies": {
		"dompurify": "^3.4.17",
		"marked": "^18.1.1"
	}
}
